# Go! API keys — copy to `.env` locally, and add the same keys in
# Vercel → Project → Settings → Environment Variables.

# https://www.yelp.com/developers/v3/manage_app
YELP_API_KEY=

# https://www.themoviedb.org/settings/api
# Use either the v3 API Key OR the Read Access Token (JWT starting with eyJ)
TMDB_API_KEY=

# Upstash Redis — required on Vercel so rooms survive across serverless
# instances. Create a free DB at https://upstash.com then paste REST creds.
# Local `npm run dev` works without these (in-memory rooms).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
