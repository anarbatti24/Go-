# Go! API keys — copy to `.env` and fill in, then restart `npm run dev`.
# Keys stay on the Vite server (never shipped to the browser).

# https://www.yelp.com/developers/v3/manage_app
YELP_API_KEY=

# https://www.themoviedb.org/settings/api
# Use either the v3 API Key OR the Read Access Token (JWT starting with eyJ)
TMDB_API_KEY=
